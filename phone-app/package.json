{
  "name": "ferit-moj-raspored-phone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config vite.mobile.config.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "apk": "npm run build && cap sync android && node scripts/build-android.mjs",
    "icons": "node scripts/sync-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@fontsource/inter": "5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
