<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@drawable/widget_glass" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
  <ImageView android:layout_width="27dp" android:layout_height="29dp" android:src="@drawable/widget_ferit_logo" android:contentDescription="FERIT"/>
  <TextView  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FERIT" android:textColor="#FFFFFF" android:textSize="16sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginStart="8dp" android:textStyle="bold"/>
  <TextView  android:layout_width="0dp" android:layout_height="wrap_content" android:text="\u0020raspored" android:textColor="#BDD3F2" android:textSize="16sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_weight="1"/>
  <ImageView android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/widget_refresh" android:contentDescription="@string/widget_refresh"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp" android:layout_marginBottom="8dp">
  <TextView  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Danas" android:textColor="#FFFFFF" android:textSize="24sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:text="20. listopada" android:textColor="#BDD3F2" android:textSize="18sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginStart="12dp" android:maxLines="1" android:ellipsize="end" android:layout_weight="1"/>
 </LinearLayout>
 <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#305E7895" android:importantForAccessibility="no"/>
 <LinearLayout android:id="@+id/widget_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
  <ImageView android:layout_width="6dp" android:layout_height="match_parent" android:src="@drawable/widget_marker" android:scaleType="fitXY" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
   <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="U tijeku" android:textColor="#19222A" android:textSize="13sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:background="@drawable/widget_pill" android:textStyle="bold"/>
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Programsko inženjerstvo" android:textColor="#FFFFFF" android:textSize="20sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginTop="6dp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_time" android:layout_width="0dp" android:layout_height="wrap_content" android:text="10:00 – 12:00" android:textColor="#BDD3F2" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_weight="1"/>
    <TextView android:id="@+id/widget_room" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K3-12" android:textColor="#BDD3F2" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:maxWidth="100dp" android:maxLines="1" android:ellipsize="end"/>
   </LinearLayout>
   <TextView android:id="@+id/widget_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LV · SR-LV3" android:textColor="#BDD3F2" android:textSize="14sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
   <LinearLayout android:id="@+id/widget_progress_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical">
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:max="10000" android:progress="6250" android:indeterminate="false" android:progressDrawable="@drawable/widget_progress" android:progressTint="#FFB987" android:progressBackgroundTint="#4D9BB1CA"/>
    <TextView android:id="@+id/widget_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Još 45 min" android:textColor="#BDD3F2" android:textSize="13sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginStart="10dp"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:visibility="gone" android:paddingTop="20dp" android:paddingBottom="20dp">
  <TextView android:id="@+id/widget_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="22sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_empty_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#BDD3F2" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginTop="8dp"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_next1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#305E7895" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
<ImageView android:id="@+id/widget_dot1" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="3dp" android:layout_marginEnd="10dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no"/>
<TextView android:id="@+id/widget_next_time1" android:layout_width="47dp" android:layout_height="wrap_content" android:text="12:15" android:textColor="#BDD3F2" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_next_title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Konzultacije" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_next_detail1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Za 1 h · 15 min pauze" android:textColor="#BDD3F2" android:textSize="12sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
<TextView android:id="@+id/widget_next_room1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T2-14" android:textColor="#BDD3F2" android:textSize="14sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:maxWidth="65dp" android:layout_marginStart="7dp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout><LinearLayout android:id="@+id/widget_next2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#305E7895" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="top">
<ImageView android:id="@+id/widget_dot2" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginTop="3dp" android:layout_marginEnd="10dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no"/>
<TextView android:id="@+id/widget_next_time2" android:layout_width="47dp" android:layout_height="wrap_content" android:text="13:15" android:textColor="#BDD3F2" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/widget_next_title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Web programiranje" android:textColor="#FFFFFF" android:textSize="15sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>

</LinearLayout>
<TextView android:id="@+id/widget_next_room2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T2-31" android:textColor="#BDD3F2" android:textSize="14sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:maxWidth="65dp" android:layout_marginStart="7dp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout>
 <LinearLayout android:id="@+id/widget_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#305E7895" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="4dp">
  <TextView android:id="@+id/widget_footer" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Još 2 termina nakon ovog" android:textColor="#BDD3F2" android:textSize="12sp" android:includeFontPadding="false" android:fontFamily="@font/widget_inter" android:layout_weight="1" android:maxLines="2" android:ellipsize="end"/>
  <ImageView android:id="@+id/widget_open" android:layout_width="30dp" android:layout_height="24dp" android:paddingStart="7dp" android:src="@drawable/widget_calendar" android:contentDescription="@string/widget_open"/>
 </LinearLayout>
</LinearLayout>
